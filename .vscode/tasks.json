{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "chartName",
      "type": "pickString",
      "description": "Select a chart to deploy",
      "options": ["homebridge", "iperf3", "rtl-sdr", "hdhomerun-app-proxy", "auto-mount", "hdhomerun-tuner-proxy", "prometheus", "xcarve", "scrypted", "firefox-remote", "website-monitor", "octoprint", "mdns-reflector"]
    },
    {
      "id": "releaseName",
      "type": "promptString",
      "description": "Enter Helm release name"
    },
    {
      "id": "namespace",
      "type": "promptString",
      "description": "Kubernetes namespace",
      "default": "ourplan"
    },
    {
      "id": "helmExtraArgs",
      "type": "promptString",
      "description": "Extra Helm args (optional, e.g., --set key=value)",
      "default": ""
    },
    {
      "id": "dockerImageTag",
      "type": "promptString",
      "description": "Docker image tag (e.g., latest, v1.0.0)",
      "default": "latest"
    },
    {
      "id": "dockerRegistry",
      "type": "pickString",
      "description": "Docker registry",
      "options": ["ghcr.io", "docker.io"],
      "default": "ghcr.io"
    }
  ],
  "tasks": [
    {
      "label": "k8s: Deploy",
      "type": "shell",
      "command": "kubectl apply -f ${file} && echo '\n--- Waiting for rollout ---' && kubectl rollout status -f ${file} --timeout=120s; echo '\n--- Current Status ---' && kubectl get -f ${file}",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "k8s: Status",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/k8s-helpers.sh status ${file}",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "k8s: Logs",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/k8s-helpers.sh logs ${file}",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "k8s: Events",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/k8s-helpers.sh events ${file}",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "k8s: Resource Usage",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/k8s-helpers.sh resources ${file}",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "k8s: Teardown",
      "type": "shell",
      "command": "echo 'Deleting resources from ${file}...' && kubectl delete -f ${file} && echo 'Resources deleted successfully.'",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "helm: Install",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/k8s-helpers.sh helm-install '${input:chartName}' '${input:releaseName}' '--namespace=${input:namespace}' ${input:helmExtraArgs}",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "helm: Upgrade",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/k8s-helpers.sh helm-upgrade '${input:chartName}' '${input:releaseName}' '--namespace=${input:namespace}' ${input:helmExtraArgs}",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "helm: Status",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/k8s-helpers.sh",
      "args": [
        "helm-status",
        "${input:releaseName}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "helm: Logs",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/k8s-helpers.sh",
      "args": [
        "helm-logs",
        "${input:releaseName}",
        "--namespace",
        "${input:namespace}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "helm: Restart",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/k8s-helpers.sh",
      "args": [
        "helm-restart",
        "${input:releaseName}",
        "--namespace",
        "${input:namespace}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "helm: Uninstall",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/k8s-helpers.sh",
      "args": [
        "helm-uninstall",
        "${input:releaseName}",
        "--namespace",
        "${input:namespace}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "helm: Quick Deploy (no rebuild)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/k8s-helpers.sh helm-upgrade '${input:chartName}' '${input:releaseName}' '--namespace=${input:namespace}' '${input:helmExtraArgs}' && sleep 3 && kubectl exec -n ${input:namespace} deployment/${input:releaseName} -- pkill -f gunicorn || true",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "docker: Build auto-mount",
      "type": "shell",
      "command": "cd ${workspaceFolder}/charts/auto-mount && docker build --platform linux/amd64 -t ${input:dockerRegistry}/billy27607/auto-mount:${input:dockerImageTag} .",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "docker: Push auto-mount",
      "type": "shell",
      "command": "docker push ${input:dockerRegistry}/billy27607/auto-mount:${input:dockerImageTag}",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "docker: Build and Push auto-mount",
      "type": "shell",
      "command": "cd ${workspaceFolder}/charts/auto-mount && docker build --platform linux/amd64 -t ${input:dockerRegistry}/billy27607/auto-mount:${input:dockerImageTag} . && docker push ${input:dockerRegistry}/billy27607/auto-mount:${input:dockerImageTag}",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "zwave: Start ZwaveJS UI (manage codes)",
      "type": "shell",
      "command": "echo '--- Starting ZwaveJS UI ---' && kubectl scale deployment homebridge-zwavejs -n homeautomation --replicas=1 && kubectl rollout status deployment/homebridge-zwavejs -n homeautomation --timeout=60s && echo '' && echo 'ZwaveJS UI ready at http://192.168.101.25:8091' && echo 'NOTE: Disable the homebridge-zwave-usb child bridge in Homebridge UI if it is enabled.'",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "zwave: Stop ZwaveJS UI (free port for HomeKit)",
      "type": "shell",
      "command": "echo '--- Stopping ZwaveJS UI ---' && kubectl scale deployment homebridge-zwavejs -n homeautomation --replicas=0 && echo 'ZwaveJS UI stopped.' && echo '' && echo 'You can now re-enable the homebridge-zwave-usb child bridge in Homebridge UI (http://192.168.101.25:8581).'",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "zwave: Status",
      "type": "shell",
      "command": "echo '=== ZwaveJS UI pod ===' && kubectl get deployment homebridge-zwavejs -n homeautomation -o wide 2>/dev/null || echo 'Not found' && echo '' && echo '=== Homebridge pod ===' && kubectl get deployment homebridge -n homeautomation -o wide 2>/dev/null || echo 'Not found' && echo '' && echo '=== Serial port holder ===' && kubectl exec -n homeautomation deployment/homebridge-zwavejs -- ls /dev/ttyACM0 2>/dev/null && echo '  -> ZwaveJS UI has /dev/ttyACM0' || echo '  -> ZwaveJS UI is not running (port may be free for homebridge)'",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
